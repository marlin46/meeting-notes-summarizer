# Required: your Claude API key (https://platform.claude.com/settings/keys)
CLAUDE_API_KEY=sk-ant-your-key-here

# Optional: Claude model to use
CLAUDE_MODEL=claude-opus-5-5

# Comma-separated frontend URLs allowed to call this API (no trailing slash)
# Example: http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Port (Railway sets this automatically; leave unset there)
PORT=3001

# Rate limit: max summarize requests per IP per window
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000
